\@writefile{lof}{\contentsline {figure}{\numberline {1.6}{\ignorespaces How retrieval-augmented generation works. Documents are split, turned into embeddings and indexed ahead of time. When a question arrives, the closest passages that the user is allowed to read are placed in the prompt, and the model answers from them and cites them.}}{14}{figure.1.6}\protected@file@percent }
\newlabel{fig:rag-pipeline}{{1.6}{14}{How retrieval-augmented generation works. Documents are split, turned into embeddings and indexed ahead of time. When a question arrives, the closest passages that the user is allowed to read are placed in the prompt, and the model answers from them and cites them}{figure.1.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.7}{\ignorespaces Embeddings place texts with similar meanings near one another. The question lands beside the policy sentences about discount approval, although it shares few words with them, so a search for the nearest points finds the right passage. Real embeddings have hundreds of dimensions; two are shown for illustration.}}{14}{figure.1.7}\protected@file@percent }
\newlabel{fig:embedding}{{1.7}{14}{Embeddings place texts with similar meanings near one another. The question lands beside the policy sentences about discount approval, although it shares few words with them, so a search for the nearest points finds the right passage. Real embeddings have hundreds of dimensions; two are shown for illustration}{figure.1.7}{}}
