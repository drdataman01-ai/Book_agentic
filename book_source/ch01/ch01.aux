\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces How retrieval-augmented generation works. Documents are split, turned into embeddings and indexed ahead of time. When a question arrives, the closest passages that the user is allowed to read are placed in the prompt, and the model answers from them and cites them.}}{10}{figure.1.4}\protected@file@percent }
\newlabel{fig:rag-pipeline}{{1.4}{10}{How retrieval-augmented generation works. Documents are split, turned into embeddings and indexed ahead of time. When a question arrives, the closest passages that the user is allowed to read are placed in the prompt, and the model answers from them and cites them}{figure.1.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces Embeddings place texts with similar meanings near one another. The question lands beside the policy sentences about discount approval, although it shares few words with them, so a search for the nearest points finds the right passage. Real embeddings have hundreds of dimensions; two are shown for illustration.}}{10}{figure.1.5}\protected@file@percent }
\newlabel{fig:embedding}{{1.5}{10}{Embeddings place texts with similar meanings near one another. The question lands beside the policy sentences about discount approval, although it shares few words with them, so a search for the nearest points finds the right passage. Real embeddings have hundreds of dimensions; two are shown for illustration}{figure.1.5}{}}
