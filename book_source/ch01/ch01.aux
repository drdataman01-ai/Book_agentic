\@writefile{lof}{\contentsline {figure}{\numberline {1.11}{\ignorespaces The agent loop. The numbers give the reading order. The loop starts with the goal (1), and the model decides the next step (2). If the model requests a tool, the framework runs it (3) and adds the result to the conversation (4), and the model decides again. When the model decides it is done, it gives the final answer (5). Step and cost limits end the loop if the model does not.}}{20}{figure.1.11}\protected@file@percent }
\newlabel{fig:agent-loop}{{1.11}{20}{The agent loop. The numbers give the reading order. The loop starts with the goal (1), and the model decides the next step (2). If the model requests a tool, the framework runs it (3) and adds the result to the conversation (4), and the model decides again. When the model decides it is done, it gives the final answer (5). Step and cost limits end the loop if the model does not}{figure.1.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1.5}{A trace of Harbor's agent at work. Each row is one pass around the agent loop, and the numbered columns match the steps in Figure~\ref {fig:agent-loop}: the model decides (2), the framework runs the tool (3), and the result is added to the conversation (4).}}{20}{table.1.5}\protected@file@percent }
\newlabel{tab:agent-trace}{{1.5}{20}{A trace of Harbor's agent at work. Each row is one pass around the agent loop, and the numbered columns match the steps in Figure~\ref {fig:agent-loop}: the model decides (2), the framework runs the tool (3), and the result is added to the conversation (4)}{table.1.5}{}}
