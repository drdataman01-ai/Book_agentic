\@writefile{toc}{\contentsline {paragraph}{The problem MCP solves.}{18}{section*.26}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.10}{\ignorespaces The problem MCP solves. Without a standard, every AI application needs its own connection to every company system. With MCP, each system is wrapped once by a server, each application contains a client, and any client can use any server.}}{18}{figure.1.10}\protected@file@percent }
\newlabel{fig:mcp-nm}{{1.10}{18}{The problem MCP solves. Without a standard, every AI application needs its own connection to every company system. With MCP, each system is wrapped once by a server, each application contains a client, and any client can use any server}{figure.1.10}{}}
\@writefile{toc}{\contentsline {paragraph}{Host, client and server.}{18}{section*.27}\protected@file@percent }
\citation{mcp2026spec}
\@writefile{lof}{\contentsline {figure}{\numberline {1.11}{\ignorespaces The parts of an MCP connection. The host is the application in which the model runs. It contains one client per server. Each server wraps one company system, is owned by the team that owns that system, and is the only way the model can reach it.}}{19}{figure.1.11}\protected@file@percent }
\newlabel{fig:mcp-arch}{{1.11}{19}{The parts of an MCP connection. The host is the application in which the model runs. It contains one client per server. Each server wraps one company system, is owned by the team that owns that system, and is the only way the model can reach it}{figure.1.11}{}}
