\@writefile{toc}{\contentsline {paragraph}{The problem MCP solves.}{13}{section*.26}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.8}{\ignorespaces The problem MCP solves. Without a standard, every AI application needs its own connection to every company system. With MCP, each system is wrapped once by a server, each application contains a client, and any client can use any server.}}{13}{figure.1.8}\protected@file@percent }
\newlabel{fig:mcp-nm}{{1.8}{13}{The problem MCP solves. Without a standard, every AI application needs its own connection to every company system. With MCP, each system is wrapped once by a server, each application contains a client, and any client can use any server}{figure.1.8}{}}
\@writefile{toc}{\contentsline {paragraph}{Host, client and server.}{13}{section*.27}\protected@file@percent }
\citation{mcp2026spec}
\@writefile{lof}{\contentsline {figure}{\numberline {1.9}{\ignorespaces The parts of an MCP connection. The host is the application in which the model runs. It contains one client per server. Each server wraps one company system, is owned by the team that owns that system, and is the only way the model can reach it.}}{14}{figure.1.9}\protected@file@percent }
\newlabel{fig:mcp-arch}{{1.9}{14}{The parts of an MCP connection. The host is the application in which the model runs. It contains one client per server. Each server wraps one company system, is owned by the team that owns that system, and is the only way the model can reach it}{figure.1.9}{}}
