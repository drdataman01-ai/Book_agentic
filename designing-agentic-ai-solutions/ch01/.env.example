# Copy to quote_desk/.env (adk web reads the agent folder's .env) and to ch01/.env.
# Values for your project come from ../setup/course.env.
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Local route instead (setup section 6): set the line above to False and add
# GOOGLE_API_KEY=your-ai-studio-key

QUOTE_DESK_MODEL=gemini-3.6-flash
